{
  "name": "collections-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "format": "oxfmt",
    "server": "node server.cjs",
    "start": "npm run build && node server.cjs",
    "install-service": "node install-service.cjs",
    "uninstall-service": "node install-service.cjs --uninstall",
    "electron:dev": "cross-env ELECTRON=true vite build && electron .",
    "electron:build": "cross-env ELECTRON=true vite build && electron-builder --win"
  },
  "dependencies": {
    "express": "^4.19.0",
    "node-windows": "^1.0.0-beta.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.3",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "oxfmt": "^0.2.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5"
  },
  "build": {
    "appId": "com.collections.app",
    "productName": "Collections",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/main.cjs",
      "electron/preload.cjs",
      "server.cjs",
      "package.json"
    ],
    "extraResources": [
      { "from": "server.cjs", "to": "server.cjs" }
    ],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "sign": false,
      "signingHashAlgorithms": null
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Collections"
    }
  }
}
